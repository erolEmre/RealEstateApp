<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 10px;
        }
    </style>
</head>
<body class="bg-background text-on-surface font-body selection:bg-secondary/30">
<!-- Top Navigation Bar (Shared Component Reference) -->
<nav class="fixed top-0 w-full z-50 bg-slate-950/70 backdrop-blur-xl shadow-sm dark:shadow-none">
<div class="flex justify-between items-center px-8 py-4 max-w-screen-2xl mx-auto">
<div class="text-2xl font-bold tracking-tighter text-blue-50 font-headline">
     <a asp-controller="Houses" asp-action="Index">Real Estate</a>
    </div>

<div class="flex items-center gap-4">
<button class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-headline text-sm font-bold tracking-tight active:scale-95 duration-200 ease-in-out">
                    List Estate
                </button>
</div>
</div>
<div class="bg-slate-800/20 h-[1px] w-full absolute bottom-0"></div>
</nav>
<main class="min-h-screen pt-20 flex flex-col md:flex-row">
<!-- Left Section: Visual Preview & Upload -->
<section class="w-full md:w-1/2 lg:w-3/5 h-[409px] md:h-[calc(100vh-80px)] sticky top-20 overflow-hidden bg-slate-900 group">
<div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" 
data-alt="ultra-modern luxury villa at twilight with glowing interior lights, infinity pool reflecting deep blue night sky, sleek architectural lines" 
style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAR-ebvvXQlkLHTU84_sU5j1z_oQkj_daVpRoTNNNRM_Jr9p7xjBAdQOzESImHmoKnNf25NahvP6vnWSS-w3dt0DcqNEbWVoaRIOUdruPsK97XS694zNjQgBNEyDT3JEKughOXpoNWyuoEHj178-oLVr5-hBKcwFE-x8v1w6pAin1WFtsEXHHALQIr1tg0bKkz4fFnHoySh96l4A9KfhpVTFqdm8Ft5L-G_75DAZtgvC9Iz2Fvp-xiy_9wLGAit1W9w0x8Gq0mM5oU')">
</div>
<!-- Glass Overlay for Upload -->
<div class="absolute inset-0 flex flex-col items-center justify-center p-8 bg-slate-950/40">
<div class="glass-panel p-8 rounded-3xl border border-white/10 flex flex-col items-center gap-4 text-center max-w-sm transition-all">
<div class="w-full max-w-md px-6">
<div class="flex flex-col gap-4">
<div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center text-blue-400 mx-auto">
<span class="material-symbols-outlined text-2xl">link</span>
</div>
<div class="text-center">
<h3 class="font-headline text-lg font-bold text-white mb-4">Görsel URL</h3>
<div class="relative group">

<input asp-for="ImageUrl"
form="House"
class="w-full bg-slate-900/60 border border-white/10 rounded-xl 
px-4 py-3 text-white placeholder:text-slate-500 focus:ring-2 focus:ring-primary 
focus:border-transparent transition-all 
outline-none font-body text-sm" 
 type="url"
 /> 

</div>
</div>
</div>
</div>
</div>
</div>
<!-- Floating Breadcrumb Overlay -->

</section>
<!-- Right Section: The Form -->
<section class="w-full md:w-1/2 lg:w-2/5 bg-background p-8 md:p-12 lg:p-16 custom-scrollbar overflow-y-auto h-auto md:h-[calc(100vh-80px)]">
<div class="max-w-xl mx-auto">
<header class="mb-12">
<h1 class="font-headline text-4xl font-extrabold tracking-tight text-white mb-2">Ev Oluştur</h1>

</header>
<form asp-controller="Houses" asp-action="Create" method="post" id="House" class="space-y-10">
    <input type="hidden" asp-for="EmployeeId" />
    <input type="hidden" asp-for="EmployeeAuth0Sub" />
    <input type="hidden" asp-for="EmployeeEmail" />
    <input type="hidden" asp-for="EmployeeFirstName" />
    <input type="hidden" asp-for="EmployeeLastName" />
<!-- Essential Information -->
<div class="space-y-6">
<div class="relative group">
<label class="block text-xs font-label uppercase tracking-widest text-slate-500 mb-2 font-bold">Başlık</label>
<input asp-for="Title" class="w-full bg-surface-container-highest/30 border border-outline-variant/30 rounded-xl px-4 py-4 text-white placeholder:text-slate-600 focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none font-headline text-lg font-semibold" 
 type="text"/>
</div>
<div class="relative group">
<label class="block text-xs font-label uppercase tracking-widest text-slate-500 mb-2 font-bold">Açıklama</label>
<textarea asp-for="Description" class="w-full bg-surface-container-highest/30 border border-outline-variant/30 rounded-xl px-4 py-4 text-white placeholder:text-slate-600 focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none font-body leading-relaxed" 
 rows="4"></textarea>
</div>
</div>
<!-- Metrics Grid (Bento Style) -->
<div class="grid grid-cols-2 gap-4">
<div class="bg-surface-container-highest/20 p-4 rounded-2xl border border-outline-variant/20">
<label class="block text-[10px] font-label uppercase tracking-widest text-slate-500 mb-2">Oda Sayısı</label>
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-blue-400">door_front</span>

<input asp-for="NumberOfRooms" class="bg-transparent border-none p-0 text-white font-headline text-xl font-bold w-full focus:ring-0" 
type="number" 
value="1"/>

</div>
</div>
<div class="bg-surface-container-highest/20 p-4 rounded-2xl border border-outline-variant/20">
<label class="block text-[10px] font-label uppercase tracking-widest text-slate-500 mb-2">Banyo Sayısı</label>
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-blue-400">bathtub</span>

<input asp-for="NumberOfBathrooms" 
class="bg-transparent border-none p-0 text-white font-headline text-xl font-bold w-full focus:ring-0" 
type="number" 
value="1"/>

</div>
</div>
<div class="bg-surface-container-highest/20 p-4 rounded-2xl border border-outline-variant/20">
<label class="block text-[10px] font-label uppercase tracking-widest text-slate-500 mb-2">Metrekare (m²)</label>
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-blue-400">square_foot</span>
<input asp-for="Area" class="bg-transparent border-none p-0 text-white font-headline text-xl font-bold w-full focus:ring-0"  type="number"/>
</div>
</div>
<div class="bg-surface-container-highest/20 p-4 rounded-2xl border border-outline-variant/20">
<label class="block text-[10px] font-label uppercase tracking-widest text-slate-500 mb-2">Fiyat</label>
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-secondary">payments</span>
<input asp-for="Price" class="bg-transparent border-none p-0 text-white font-headline text-xl font-bold w-full focus:ring-0" 
placeholder="" 
type="text"/>
</div>
</div>
</div>
<!-- Location Cluster -->
<div class="space-y-6">
<h3 class="text-xs font-label uppercase tracking-widest text-blue-400 font-bold">Adres Bilgileri</h3>
<div class="grid grid-cols-2 gap-4">
<div class="col-span-2 relative">
<span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-500">location_on</span>
<input asp-for="Street" class="w-full bg-surface-container-highest/30 border border-outline-variant/30 rounded-xl pl-12 pr-4 py-4 text-white focus:ring-2 focus:ring-primary outline-none" 
placeholder="Sokak" type="text"/>
</div>
<input asp-for="City" class="w-full bg-surface-container-highest/30 border border-outline-variant/30 rounded-xl px-4 py-4 text-white focus:ring-2 focus:ring-primary outline-none" 
placeholder="Şehir" type="text"/>
<input asp-for="District" class="w-full bg-surface-container-highest/30 border border-outline-variant/30 rounded-xl px-4 py-4 text-white focus:ring-2 focus:ring-primary outline-none" 
placeholder="Semt/İlçe" type="text"/>
<input asp-for="ApartmentNo" class="w-full bg-surface-container-highest/30 border border-outline-variant/30 rounded-xl px-4 py-4 text-white focus:ring-2 focus:ring-primary outline-none" 
placeholder="Bina Numarası" type="text"/>
<input asp-for="BuildingNo" class="w-full bg-surface-container-highest/30 border border-outline-variant/30 rounded-xl px-4 py-4 text-white focus:ring-2 focus:ring-primary outline-none" 
placeholder="Daire Numarası" type="text"/>
</div>
</div>
<!-- Contact & Availability -->
<div class="flex flex-col md:flex-row items-center gap-8 py-6 border-t border-slate-800">
<div class="flex-1 w-full">
<label class="block text-xs font-label uppercase tracking-widest text-slate-500 mb-2 font-bold">İletişim No:</label>
<div class="relative">
<span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-500">phone</span>
<input asp-for="ContactNumber" class="w-full bg-surface-container-highest/30 border border-outline-variant/30 rounded-xl pl-12 pr-4 py-4 text-white focus:ring-2 focus:ring-primary outline-none" 
placeholder="0555 555 11 11" type="tel"/>
</div>
</div>
<div class="flex gap-4 bg-slate-900/50 p-4 rounded-2xl border border-slate-800">
<div class="flex flex-col gap-2">
<span class="text-xs font-label uppercase tracking-widest text-slate-500 font-bold">İlana Açılsın Mı?</span>
<label class="relative inline-flex items-center cursor-pointer mt-2">
    <input asp-for="IsAvailable" class="sr-only peer" type="checkbox" />
    
    <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer 
                peer-checked:after:translate-x-full peer-checked:after:border-white 
                after:content-[''] after:absolute after:top-[2px] after:left-[2px] 
                after:bg-white after:border-gray-300 after:border after:rounded-full 
                after:h-5 after:w-5 after:transition-all peer-checked:bg-secondary">
    </div>
</label>
<span class="text-xs font-label uppercase tracking-widest text-slate-500 font-bold">Kiralık Mı?</span>
<label class="relative inline-flex items-center cursor-pointer mt-2">
    <input asp-for="IsRental" class="sr-only peer" type="checkbox" />
    
    <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer 
                peer-checked:after:translate-x-full peer-checked:after:border-white 
                after:content-[''] after:absolute after:top-[2px] after:left-[2px] 
                after:bg-white after:border-gray-300 after:border after:rounded-full 
                after:h-5 after:w-5 after:transition-all peer-checked:bg-secondary">
    </div>
    
</label>

</div>
</div>
</div>
<!-- Action Footer -->
<div class="pt-8 pb-12">
    
<button class="w-full bg-secondary text-white font-headline text-lg font-bold py-5 rounded-2xl shadow-xl shadow-secondary/20 hover:bg-secondary-container active:scale-[0.98] transition-all flex items-center justify-center gap-3" 
type="submit">
<span class="material-symbols-outlined">publish</span>
                            Yayınla
                        </button>
</div>
</form>
</div>
</section>
</main>
<!-- Footer (Shared Component Reference) -->
<footer class="w-full py-12 border-t border-slate-800 bg-slate-950">
<div class="flex flex-col md:flex-row justify-between items-center px-12 max-w-7xl mx-auto gap-6">
<div class="text-lg font-bold text-blue-50 font-headline">Real Estate</div>

</div>
</footer>
</body></html>


