@model RealEstate.Application.ViewModel.HouseVM;
@using RealEstate.Core.Models.Enums;
@using System.Security.Claims

@{
    ViewData["Title"] = "Ev bilgilerini gir..";
    Layout = null;
}


<!DOCTYPE html>

