<table class="table table-hover align-middle">
	<thead class="table-dark">
		<tr>
			<th>@Html.DisplayNameFor(model => model.Title)</th>
			<th>@Html.DisplayNameFor(model => model.NumberOfRooms)</th>
			<th>@Html.DisplayNameFor(model => model.NumberOfBathrooms)</th>
			<th class="text-center">@Html.DisplayNameFor(model => model.Area)</th>
			<th class="text-end">@Html.DisplayNameFor(model => model.Price)</th>
			<th class="text-center">@Html.DisplayNameFor(model => model.IsAvailable)</th>
			@{				
					<th>İşlemler</th>
			}
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td class="fw-bold">
					@item.Title
					<br />
					<small class="text-muted fw-normal">@item.ContactNumber</small>
				</td>
				<td>
					<span class="badge bg-primary text-dark">
						@Html.DisplayFor(modelItem => item.NumberOfRooms) Oda

					</span>
				</td>
				<td>
					<span class="badge bg-info text-dark">
						@Html.DisplayFor(modelItem => item.NumberOfBathrooms) Banyo
					</span>
				</td>
				<td class="text-center">@item.Area m²</td>
				<td class="text-end fw-bold">
					@item.Price.ToString("N0") ₺
				</td>
				<td class="text-center">
					@if (item.IsAvailable)
					{
						<span class="badge rounded-pill bg-success">
							<i class="bi bi-check-circle me-1"></i> Aktif
						</span>
					}
					else
					{
						<span class="badge rounded-pill bg-danger">
							<i class="bi bi-x-circle me-1"></i> Pasif
						</span>
					}
				</td>
				<td>
					@{
						var employeeId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

						if (item.Employee != null && item.Employee.Auth0Sub == employeeId)
						{

							<div class="btn-group btn-group-sm" role="group">
							<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Düzenle</a>
								<div class="btn-group btn-group-sm" role="group">
									<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Detay</a>
								</div>
								<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Sil</a>
							</div>
						}
						else 
						{
							<div class="btn-group btn-group-sm" role="group">
								<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Detay</a>
							</div>
						}

					}
				</td>
			</tr>
		}
	</tbody>
</table>
