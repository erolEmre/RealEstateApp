	<div class="table-responsive rounded-3 overflow-hidden shadow-sm" style="border:1px solid #2e3138;">
  <table class="table table-hover align-middle mb-0" style="background:#1e2126;font-size:13px;">

    <thead style="background:#16181d;border-bottom:1px solid #2e3138;">
      <tr>
        <th class="px-4 py-3 fw-medium text-secondary" style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;border:none;">@Html.DisplayNameFor(model => model.Title)</th>
        <th class="px-3 py-3 fw-medium text-secondary" style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;border:none;">@Html.DisplayNameFor(model => model.NumberOfRooms)</th>
        <th class="px-3 py-3 fw-medium text-secondary" style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;border:none;">@Html.DisplayNameFor(model => model.NumberOfBathrooms)</th>
        <th class="px-3 py-3 fw-medium text-secondary text-center" style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;border:none;">@Html.DisplayNameFor(model => model.Area)</th>
        <th class="px-3 py-3 fw-medium text-secondary text-end" style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;border:none;">@Html.DisplayNameFor(model => model.Price)</th>
        <th class="px-3 py-3 fw-medium text-secondary text-center" style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;border:none;">@Html.DisplayNameFor(model => model.IsAvailable)</th>
        <th class="px-4 py-3 fw-medium text-secondary text-end" style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;border:none;">İşlemler</th>
      </tr>
    </thead>

    <tbody>
      @foreach (var item in Model)
      {
        <tr style="border-color:#2e3138;">
          <td class="px-4 py-3" style="border-color:#2e3138;">
            <span class="fw-semibold" style="color:#f1f3f5;">@item.Title</span>
            <br />
            <small class="text-secondary" style="font-size:11px;">@item.ContactNumber</small>
          </td>

          <td class="px-3 py-3" style="border-color:#2e3138;">
            <span class="badge rounded-pill" style="font-size:11px;background:#1a2a3a;color:#66aadd;border:1px solid #2d4d6a;">
              @Html.DisplayFor(modelItem => item.NumberOfRooms) Oda
            </span>
          </td>

          <td class="px-3 py-3" style="border-color:#2e3138;">
            <span class="badge rounded-pill" style="font-size:11px;background:#1a2e2a;color:#4dbb9a;border:1px solid #2d5e4e;">
              @Html.DisplayFor(modelItem => item.NumberOfBathrooms) Banyo
            </span>
          </td>

          <td class="px-3 py-3 text-center" style="color:#9aa0a8;border-color:#2e3138;">
            @item.Area <span class="text-secondary">m²</span>
          </td>

          <td class="px-3 py-3 text-end fw-semibold" style="color:#4dbb7a;border-color:#2e3138;">
            @item.Price.ToString("N0") ₺
          </td>

          <td class="px-3 py-3 text-center" style="border-color:#2e3138;">
            @if (item.IsAvailable)
            {
              <span class="badge rounded-pill" style="font-size:11px;background:#1a3a28;color:#4dbb7a;border:1px solid #2d6644;">✓ Aktif</span>
            }
            else
            {
              <span class="badge rounded-pill" style="font-size:11px;background:#3a1a1a;color:#cc6666;border:1px solid #662d2d;">✗ Pasif</span>
            }
          </td>

          <td class="px-4 py-3 text-end" style="border-color:#2e3138;">
            @{
              var employeeId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
              if (item.Employee != null && item.Employee.Auth0Sub == employeeId)
              {
                <div class="d-flex justify-content-end gap-1">
                  <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:11px;">Detay</a>
                  <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-2 py-1" style="font-size:11px;">Düzenle</a>
                  <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-2 py-1" style="font-size:11px;">Sil</a>
                </div>
              }
              else
              {
                <div class="d-flex justify-content-end">
                  <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:11px;">Detay</a>
                </div>
              }
            }
          </td>
        </tr>
      }
    </tbody>

  </table>
</div>

