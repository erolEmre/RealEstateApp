@using System.Security.Claims
@model RealEstate.Application.ViewModel.Houses.HouseVM

@{
	ViewData["Title"] = "Detaylar";
	Layout = null;
}

<!DOCTYPE html>

<html class="scroll-smooth" lang="tr">
<head>
	<meta charset="utf-8" />
	<meta content="width=device-width, initial-scale=1.0" name="viewport" />
	<title>@Model.Title</title>
	<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
	<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
	<script id="tailwind-config">
		tailwind.config = {
		darkMode: "class",
		theme: {
		extend: {
		colors: {
		"primary-fixed": "#d7e2ff",
		"on-surface-variant": "#424751",
		"primary-container": "#004a99",
		"outline-variant": "#c2c6d3",
		"error": "#ba1a1a",
		"secondary": "#a53c00",
		"inverse-primary": "#abc7ff",
		"surface-tint": "#255dad",
		"primary-fixed-dim": "#abc7ff",
		"on-error-container": "#93000a",
		"on-tertiary-container": "#ffa884",
		"on-background": "#191c1e",
		"secondary-container": "#fd702d",
		"on-primary-container": "#9bbdff",
		"on-secondary": "#ffffff",
		"error-container": "#ffdad6",
		"surface-variant": "#e0e3e5",
		"primary": "#00346f",
		"on-primary-fixed": "#001b3f",
		"on-tertiary": "#ffffff",
		"on-error": "#ffffff",
		"background": "#f8f9fb",
		"surface-container-high": "#e6e8ea",
		"surface-dim": "#d8dadc",
		"surface-container-low": "#f2f4f6",
		"on-primary-fixed-variant": "#00458f",
		"on-secondary-fixed-variant": "#7e2c00",
		"on-tertiary-fixed": "#370f00",
		"inverse-surface": "#2d3133",
		"on-tertiary-fixed-variant": "#7e2c00",
		"tertiary-fixed": "#ffdbce",
		"on-secondary-fixed": "#370f00",
		"on-primary": "#ffffff",
		"tertiary-container": "#873000",
		"surface-bright": "#f8f9fb",
		"tertiary": "#622000",
		"on-surface": "#191c1e",
		"outline": "#737783",
		"surface-container-lowest": "#ffffff",
		"surface": "#f8f9fb",
		"secondary-fixed-dim": "#ffb598",
		"on-secondary-container": "#5d1f00",
		"tertiary-fixed-dim": "#ffb598",
		"surface-container": "#eceef0",
		"inverse-on-surface": "#eff1f3",
		"surface-container-highest": "#e0e3e5",
		"secondary-fixed": "#ffdbce"
		},
		fontFamily: {
		"headline": ["Manrope"],
		"body": ["Inter"],
		"label": ["Inter"]
		},
		borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
		},
		},
		}
	</script>
	<style>
		.material-symbols-outlined {
		font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
		}

		.bg-glass {
		background: rgba(15, 23, 42, 0.7);
		backdrop-filter: blur(24px);
		}

		.editorial-gradient {
		background: linear-gradient(135deg, #00346f 0%, #004a99 100%);
		}
	</style>
</head>
<body class="bg-slate-950 text-slate-200 font-body selection:bg-blue-500 selection:text-white">
	<!-- TopNavBar -->
	<nav class="fixed top-0 w-full z-50 bg-slate-950/70 backdrop-blur-xl border-b border-slate-800/50 shadow-2xl shadow-blue-900/10">
		<div class="flex justify-between Models-center w-full px-6 py-4 max-w-screen-2xl mx-auto">
			<div class="text-2xl font-bold tracking-tighter text-slate-100 font-headline">
				<a asp-action="Index" asp-controller="Houses">Real Estate</a>
				</div>
			<div class="flex Models-center space-x-4">
			</div>
		</div>
	</nav>
	<main class="pt-16">
		<!-- Hero Section - Reduced height to 65vh (approx 700px on 1080p) -->
		<section class="relative h-[55vh] min-h-[300px] w-full overflow-hidden">
			<div class="w-full aspect-video bg-slate-900 rounded-2xl overflow-hidden border border-slate-800 shadow-xl group">
				<img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
					 alt="@Model.Title"
					 src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-house.jpg" : Model.ImageUrl)" />
			</div>
			<div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
			<div class="absolute bottom-0 left-0 w-full p-8 md:p-12 max-w-screen-2xl mx-auto">
				<div class="flex flex-col md:flex-row md:Models-end justify-between gap-6">

   
                      

					<div class="space-y-4 max-w-3xl">
						<div class="flex Models-center gap-3">
							@{
								string rentalStatus = "";
								if (@Model.IsRental) rentalStatus = "Kiralık";
								else rentalStatus = "Satılık";
								<span class="bg-green-500 text-black-400 px-4 py-2
								rounded-full text-xs font-bold tracking-widest uppercase
								border border-black-400/30">@rentalStatus</span>
							}
							@* <span class="text-slate-500 text-md font-medium flex Models-center gap-1">
                                        <span class="material-symbols-outlined text-md">calendar_today</span>
                                        @Model.ListingDate.ToShortDateString()
                                    </span> *@
						</div>
						<h1 class="font-headline text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
							@Model.Title / @Model.Description
						</h1>
						<p class="text-lg text-slate-300 font-medium flex Models-center gap-2">
							<span class="material-symbols-outlined text-blue-400">location_on</span>
							@Model.District, @Model.City
						</p>
					</div>
					<div class="bg-glass p-6 md:p-8 rounded-3xl border border-slate-700/50 shadow-2xl">
						<span class="text-slate-400 text-xs font-label uppercase tracking-widest block mb-1">Satış Fiyatı</span>
						<div class="text-3xl md:text-4xl font-extrabold text-blue-400 font-headline">
							@Model.Price ₺
						</div>
					</div>

				</div>
			</div>
		</section>
		<!-- Content Grid -->
		<section class="max-w-screen-2xl mx-auto px-8 md:px-16 py-12 grid grid-cols-1 lg:grid-cols-12 gap-12">
			<!-- Main Content Area -->
			<div class="lg:col-span-8 space-y-12">
				<!-- Description Card -->
				<div class="bg-slate-900/40 p-10 rounded-[2rem] border border-slate-800/50">
					<h2 class="font-headline text-2xl font-bold mb-6 text-white">Mülk Açıklaması</h2>
					<p class="text-slate-400 leading-relaxed text-lg font-body">

						<p>@Model.Description</p>

					</div>
					<!-- Features Bento Grid -->
					<div class="grid grid-cols-2 md:grid-cols-4 gap-6">

   
                            
						<div class="bg-slate-900/60 p-6 rounded-3xl border border-slate-800/50 hover:bg-slate-800/60 transition-colors">
							<span class="material-symbols-outlined text-blue-400 text-3xl mb-4">door_open</span>
							@* <div class="text-2xl font-bold text-white">@Html.DisplayFor(m => m.NumberOfRooms)</div> *@
							<div class="text-2xl font-bold text-white">@Html.DisplayFor(m => m.NumberOfRooms)</div>
							<div class="text-slate-500 text-xs font-label uppercase tracking-widest mt-1">Oda</div>
						</div>
						<div class="bg-slate-900/60 p-6 rounded-3xl border border-slate-800/50 hover:bg-slate-800/60 transition-colors">
							<span class="material-symbols-outlined text-blue-400 text-3xl mb-4">shower</span>
							<div class="text-2xl font-bold text-white">@Model.NumberOfBathrooms</div>
							<div class="text-slate-500 text-xs font-label uppercase tracking-widest mt-1">Banyo</div>
						</div>
						<div class="bg-slate-900/60 p-6 rounded-3xl border border-slate-800/50 hover:bg-slate-800/60 transition-colors">
							<span class="material-symbols-outlined text-blue-400 text-3xl mb-4">straighten</span>
							<div class="text-2xl font-bold text-white">@Model.Area m²</div>
							<div class="text-slate-500 text-xs font-label uppercase tracking-widest mt-1">Net Alan</div>
						</div>
						<div class="bg-slate-900/60 p-6 rounded-3xl border border-slate-800/50 hover:bg-slate-800/60 transition-colors">
							<span class="material-symbols-outlined text-blue-400 text-3xl mb-4">apartment</span>
							<div class="text-2xl font-bold text-white">Kat 12</div>
							<div class="text-slate-500 text-xs font-label uppercase tracking-widest mt-1">Bulunduğu Kat</div>
						</div>

					</div>
					<!-- Address & Location Section -->
					<div class="bg-slate-900/40 p-10 rounded-[2rem] border border-slate-800/50 overflow-hidden relative">
						<div class="flex flex-col md:flex-row justify-between gap-8">
							<div class="space-y-6">

								<h2 class="font-headline text-2xl font-bold text-white">Konum Detayları</h2>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4">
									<div class="flex flex-col">
										<span class="text-slate-500 text-xs font-label uppercase tracking-widest">Şehir / İlçe</span>
										<span class="text-slate-200 text-lg">@Model.City / @Model.District</span>
									</div>

									<div class="flex flex-col">
										<span class="text-slate-500 text-xs font-label uppercase tracking-widest">Sokak / No</span>
										<span class="text-slate-200 text-lg">@Model.Street @Model.BuildingNo</span>
									</div>
									<div class="flex flex-col">
										<span class="text-slate-500 text-xs font-label uppercase tracking-widest">Daire</span>
										<span class="text-slate-200 text-lg">@Model.ApartmentNo</span>
									</div>
								</div>

							</div>
							<div class="md:w-1/3 h-48 rounded-2xl overflow-hidden border border-slate-700/50 grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all cursor-pointer">
								<img class="w-full h-full object-cover" data-alt="Modern satellite map view of coastal city area with focus on waterfront district"
									 data-location="Istanbul, Bebek"
									 src="https://lh3.googleusercontent.com/aida-public/AB6AXuCTS62CwI5CYFOSKdpQAdKgjvQz1Aedzk_-o7pLgiy7OMpVY4TCO_bZ0SZtehD-3Hj3pS5dHZ9YRDfwT324Iut9GQUJ3E-UwePzfsIVcAfgYKGDBoU9RkZ4xKwCn3GekKijp8Ab9FMQ7hZBD3tSXX_ADX25E4WNEuFRydERPhr6Jy6v56UzuxWNOKAJOubR-mNopiOl_MsgW0Wpy98hlkfu87RZFpMHXjdZTFbsvYf4KLjFoyLd9ZVWnZ_F-rJli60jBX8IWo5V8sQ" />
							</div>
						</div>
					</div>
				</div>
				<!-- Sidebar Actions -->
				<div class="lg:col-span-4">
					<div class="sticky top-28 space-y-6">
						<!-- Agent Card -->
						<div class="bg-slate-900 p-8 rounded-[2rem] border border-slate-800 shadow-xl">

							<div class="space-y-4 mb-8">
								<div class="bg-slate-950 p-5 rounded-2xl flex flex-col gap-3 border border-slate-800">
									<div class="flex items-center gap-3">
										<span class="text-slate-200 font-mono tracking-wider font-semibold">@Model.EmployeeFirstName</span>
										<span class="text-slate-200 font-mono tracking-wider font-semibold">@Model.EmployeeLastName</span>
									</div>

									<div class="border-t border-slate-800/60 my-1"></div>

									<div class="flex items-center gap-2">
										<span class="material-symbols-outlined text-slate-400 text-xl">phone_iphone</span>
										<span class="text-slate-200 font-mono tracking-wider font-semibold">@Model.ContactNumber</span>
									</div>
								</div>
							</div>
							<div class="space-y-3">

								@{

									var employeeId = User.FindFirstValue(ClaimTypes.NameIdentifier);
									if (User.Identity.IsAuthenticated && User.IsInRole("Agent"))
									{
										if (Model.EmployeeAuth0Sub != null && employeeId == Model.EmployeeAuth0Sub)
										{
											<button type="submit"
													class="w-full py-4 px-6 bg-primary text-white rounded-full font-bold 
												text-lg hover:bg-primary-container transition-all
												flex Models-center justify-center
												gap-2 active:scale-95">
												<span class="material-symbols-outlined">edit</span>
												<a asp-action="Edit" asp-controller="Houses" asp-route-id="@Model.Id">Düzenle</a>
											</button>

										}
									}
								}

                    
								<button class="w-full py-4 px-6 bg-slate-800 text-slate-200
									rounded-full font-bold text-lg hover:bg-slate-700
									transition-all flex Models-center justify-center active:scale-95">
									<span class="material-symbols-outlined">arrow_back</span>
									<a asp-controller="Houses" asp-action="Index" class="btn btn-outline-light px-4">Listeye Dön</a>
								</button>

								<button type="button"
										class="w-full py-4 px-6 bg-red-600 text-white rounded-full font-bold text-lg
									hover:bg-red-700 transition-all flex items-center justify-center active:scale-95">
									<a asp-controller="Houses"
									   asp-action="Delete"
									   asp-route-id="@Model.Id"
									   onclick="return confirm('Bu evi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');"
									   class="text-white no-underline w-full h-full block text-center">
										Evi Sil
									</a>
								</button>
							</div>
						</div>
						<!-- Quick Tools -->

					</div>
				</div>
			</section>
		</main>
		<!-- Footer -->
		<footer class="bg-slate-950 w-full border-t border-slate-900 mt-20">
			<div class="flex flex-col md:flex-row justify-between Models-center px-12 py-10 w-full max-w-screen-2xl mx-auto">
				<div class="flex flex-col Models-center md:Models-start mb-8 md:mb-0">
				</div>

			</div>
		</footer>
	</body>
</html>


            